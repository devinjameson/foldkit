{
  "name": "{{name}}",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --outDir dist/client && vite build --ssr server/main.ts --outDir dist/server",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier -w .",
    "test": "vitest run",
    "lint": "oxlint src server"
  }
}
