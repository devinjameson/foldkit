{
  "name": "@foldkit/lustre-benchmark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm build:naive && pnpm build:optimised",
    "build:naive": "vp build",
    "build:optimised": "BUILD_VARIANT=optimised vp build && mv dist/optimised/index.optimised.html dist/optimised/index.html",
    "bench:install": "node bench/install.mjs",
    "bench:run": "node bench/run.mjs",
    "bench:verify": "node bench/verify.mjs",
    "dev": "vp dev",
    "profile": "RUN_LUSTRE_PROFILE=1 vp test run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112",
    "foldkit": "workspace:*"
  },
  "devDependencies": {
    "@foldkit/vite-plugin": "workspace:*",
    "@types/node": "^26.4.0",
    "happy-dom": "^20.11.13",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  }
}
